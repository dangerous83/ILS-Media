# ── Access ──────────────────────────────────────────────
# Password for the platform login screen.
ACCESS_PASSWORD=ILS@2026
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# ── Vercel Blob ─────────────────────────────────────────
# Added automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# ── Cloudflare R2 ───────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ils-media
# Optional: public bucket URL (r2.dev or custom domain). If empty, signed URLs are used.
R2_PUBLIC_URL=

# Which storage new uploads go to by default: "r2" or "blob".
DEFAULT_STORAGE=r2
